<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Generator Sertifikat J-Expert</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<style>
:root{--bg:#fff;--pn:#f6f8fc;--tx:#1f2937;--mu:#64748b;--ac:#1b4b8a;--ac2:#c8453f;--bd:#dbe2ec}
*{box-sizing:border-box}body{margin:0;font:14px system-ui,sans-serif;background:var(--bg);color:var(--tx)}
header{padding:10px 14px;background:linear-gradient(90deg,#1b4b8a,#2f6bb8);border-bottom:3px solid var(--ac2);color:#fff;font-weight:700}.rw{display:flex;gap:4px;flex-wrap:wrap;align-items:center;margin-bottom:5px}
.tabs{display:none}.main{display:grid;grid-template-columns:420px 1fr;height:calc(100vh - 44px)}
#L{overflow:auto;padding:10px}#R{display:flex;flex-direction:column;min-width:0}
.card{background:var(--pn);border:1px solid var(--bd);border-radius:10px;padding:10px;margin-bottom:10px;box-shadow:0 1px 4px rgba(30,60,110,.08)}
.card h3{margin:0 0 4px;font-size:14px;color:var(--ac)}.hint{color:var(--mu);font-size:12px;margin:0 0 6px}
input,textarea,select,button{font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--bd);border-radius:6px;padding:6px;max-width:100%}
textarea{width:100%;min-height:90px}input[type=text],input:not([type]),input[type=number]{width:100%}
button{cursor:pointer;background:var(--ac);color:#fff;border:0;padding:7px 10px;margin:2px}button.g{background:#fff;color:var(--ac);border:1px solid var(--bd)}button.g:hover{background:#eef3fb}
.row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.row>*{flex:1 1 90px}.p{border-top:1px dashed var(--bd);padding-top:6px;margin-top:6px}
#bar{padding:6px;display:flex;gap:4px;flex-wrap:wrap;align-items:center;background:var(--pn);border-bottom:1px solid var(--bd)}#bar button,#bar select{flex:0 0 auto}
#vw{flex:1;overflow:auto;background:#e8edf5;position:relative;touch-action:pan-x pan-y}#pgw{margin:10px}
#pg{transform-origin:0 0;position:relative;width:1414px;height:2000px;background:#fff;box-shadow:0 4px 24px rgba(30,60,110,.25)}
.el{position:absolute;white-space:pre;line-height:1.2}.ed .el{outline:1px dashed rgba(0,110,255,.7);cursor:move;touch-action:none}.ed .el.sel{outline:2px solid #e11}
.hd{position:absolute;right:-14px;bottom:-14px;width:28px;height:28px;background:#e11;border-radius:50%;cursor:nwse-resize;touch-action:none}
.gd{position:absolute;background:rgba(220,0,200,.9);z-index:9;touch-action:none}.gd.v{width:3px;top:0;height:2000px;cursor:ew-resize}.gd.h{height:3px;left:0;width:1414px;cursor:ns-resize}
#vw.pn,#vw.pn *{cursor:grab!important;touch-action:none}#R{overflow:hidden}#bar,#st,#props{flex:none;touch-action:pan-x pan-y}#props{min-height:132px}#vw{min-height:0}details.card>summary{cursor:pointer;font-weight:700;color:var(--ac);list-style:none;user-select:none}details.card>summary::-webkit-details-marker{display:none}details.card>summary::before{content:"▸ "}details[open].card>summary::before{content:"▾ "}details[open].card>summary{margin-bottom:8px}#msg:empty{display:none}#st{font-size:12px;padding:4px 8px;background:var(--pn)}
@media(max-width:820px){.main{display:block;height:auto}.tabs{display:flex}.tabs button{flex:1;border-radius:0}#R{height:80vh}body.v1 #R,body:not(.v1) #L{display:none}}
</style></head><body class="v1">
<header>🎓 Generator Sertifikat J-Expert (Bulk PDF)</header>
<div class="tabs"><button onclick="document.body.classList.add('v1')">1 · Isi Data</button><button onclick="document.body.classList.remove('v1');fit()">2 · Preview & Edit</button></div>
<div class="main"><div id="L">
<details class="card"><summary>Cara pakai (5 langkah)</summary><ol class="hint" style="padding-left:18px;margin:0"><li>Tempel pesan mentah (nama + baris “Tanggal …”), klik Proses.</li><li>Isi bidang, kualifikasi, masa berlaku (sekali untuk semua atau per nama).</li><li>Isi penanggung jawab, daftar unit kompetensi, upload tanda tangan.</li><li>Cek & rapikan di Preview: geser, ubah ukuran, rotasi, warna, font.</li><li>Klik ⬇ PDF (satu orang) atau ⬇ ZIP (semua) di toolbar preview.</li></ol></details>
<details class="card"><summary>1 · Pesan mentah</summary><p class="hint">Satu nama per baris, lalu “Tanggal 18 November 2026”.</p><textarea id="raw">Gilang Wibisono Putro
Gyokanne
Arif Surahman
Ari Tri Wahyudi
Tuty Endarwati
Daniel Dwi Putranto
Anita Johana Marpaung
Indah Sulistiawati

Tanggal 18 November 2026</textarea><button onclick="parse()">Proses</button></details>
<details class="card"><summary>2 · Bidang & kompetensi</summary><label><input type="checkbox" id="same" checked onchange="S.same=this.checked;ui()"> Sama untuk semua nama</label><br><label><input type="checkbox" id="auto" checked onchange="S.auto=this.checked?1:0"> Terjemah Inggris otomatis (saat Indonesia diubah)</label> <span id="tm" class="hint"></span><div id="com"></div><button class="g" onclick="acak()">🎲 Acak nomor & registrasi</button> <label class="hint">Awalan nomor <input id="pfx" value="1933" style="width:80px" oninput="S.prefix=this.value;nums(0);ui()"></label><p class="hint">Tombol acak mengisi awalan dengan tanggal+bulan hari ini (DDMM); tahun mengikuti tahun berjalan.</p><div id="ppl"></div></details>
<details class="card"><summary>3 · Penanggung jawab, unit & tanda tangan</summary><p class="hint">Nama penanggung jawab</p><input id="pj" value="Nama Penanggung Jawab" oninput="S.pj=this.value;rr()">
<p class="hint p">Kolom tabel — ubah tulisan header, lebar (px, 0 = otomatis), dan centang “2 baris” bila kolom berisi teks Indonesia + Inggris.</p><div id="cols"></div><button class="g" onclick="addCol()">＋ Tambah kolom</button>
<p class="hint p">Isi tabel per baris. ＋ untuk tambah baris, ✕ untuk hapus.</p><div id="rows"></div><button class="g" onclick="addRow()">＋ Tambah baris</button><button class="g" onclick="trRows()">🌐 Terjemahkan semua baris ke Inggris</button><button class="g" style="color:var(--ac2)" onclick="clrRows()">⌫ Hapus semua baris Inggris</button>
<p class="hint p">TTD digital 1 (halaman depan) · TTD digital 2 (halaman belakang) — PNG transparan terbaik</p><div class="row"><input type="file" accept="image/*" onchange="sig(1,this)"><input type="file" accept="image/*" onchange="sig(2,this)"></div></details>

</div><div id="R"><div id="bar">
<select id="cp" onchange="S.cur=+this.value;rr()"></select><button class="g" id="b1" onclick="S.pg=1;rr()">Depan</button><button class="g" id="b2" onclick="S.pg=2;rr()">Belakang</button>
<button class="g" onclick="undo()" title="Ctrl+Z">↶ Undo</button><button class="g" onclick="redo()" title="Ctrl+Y">↷ Redo</button><button class="g" id="bp" onclick="S.pan=!S.pan;this.style.outline=S.pan?'2px solid var(--ac)':'';pnm()">✋ Geser</button><button class="g" onclick="zm(1.25)">＋</button><button class="g" onclick="zm(.8)">－</button><button class="g" onclick="fit()">Fit</button>
<button class="g" id="bs" onclick="S.snap=!S.snap;this.textContent='Snap: '+(S.snap?'ON':'OFF')">Snap: ON</button><button class="g" onclick="S.edit=!S.edit;rr()">Kotak edit</button>
<button class="g" onclick="gd('v')">＋Garis V</button><button class="g" onclick="gd('h')">＋Garis H</button><button class="g" onclick="S.gd=[];rr()">Hapus garis</button><button style="margin-left:auto" onclick="dl(0)">⬇ PDF</button><button onclick="dl(1)">⬇ ZIP semua</button><span id="msg" class="hint" style="flex:1 1 100%"></span></div>
<div id="vw"><div id="pgw"><div id="pg"></div></div></div><div id="st"></div></div></div>
<div id="host" style="position:fixed;left:-20000px;top:0"></div>
<script>
const T1="data:image/jpeg;base64,",T2="data:image/jpeg;base64,";
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const E=(id,pg,t,x,yc,w,s,al,o={})=>({id,pg,t,x,y:Math.round(yc-s*.6),w,s,al,c:'#1d1d1d',f:'Arial',b:0,i:0,r:0,...o});
const S={same:1,pg:1,cur:0,z:.5,px:0,py:0,auto:1,snap:1,edit:1,sel:null,gd:[],sig:{},pj:'Nama Penanggung Jawab',date:'18 November 2026',prefix:'1933',people:[],
com:{bI:'PENDIDIKAN DAN PELATIHAN',bE:'Education and Training',kI:'INSTRUKTUR',kE:'INSTRUCTOR',mI:'3 tahun',mE:'3 years'},
tbl:`1|DEMO-01|Menyusun Program Pelatihan Kerja|Compiling Job Training Program
2|DEMO-02|Merencanakan Penyajian Materi Pelatihan Kerja|Planning Presentation of Job Training Materials
3|DEMO-03|Merencanakan Evaluasi Hasil Pembelajaran|Planning Evaluation of Learning Outcomes
4|DEMO-04|Melaksanakan Pelatihan Tatap Muka (Face to Face)|Carrying out Face to Face Training
5|DEMO-05|Menerapkan Keamanan, Kesehatan, dan Keselamatan Kerja (K3) di Lembaga Pelatihan Kerja|Implementing Occupational Safety and Health (K3) in Job Training Institutions
6|DEMO-06|Mengelola Pemenuhan Persyaratan Bahasa, Literasi, dan Berhitung dalam Proses Pembelajaran|Organizing the Learning Process to Meet Language, Literacy, and Numeracy Needs
7|DEMO-07|Menilai Kemajuan Kompetensi Peserta Pelatihan Secara Individu|Assessing the Competency Progress of Individual Training Participants
8|DEMO-08|Menentukan Kebutuhan Pelatihan Individu|Identifying Individual Training Requirements
9|DEMO-09|Merancang Strategi Pembelajaran|Designing Learning Strategies
10|DEMO-10|Mengelola Bahan Pelatihan Kerja|Managing Job Training Materials
11|DEMO-11|Mengelola Peralatan Pelatihan Kerja|Managing Job Training Equipment
12|DEMO-12|Menyiapkan Pelaksanaan Pelatihan atau Asesmen Berbasis Kompetensi|Prepare the Implementation of Competency-Based Training or Assessment
13|DEMO-13|Melaksanakan Pelatihan Berbasis Kompetensi PBK|Carry out PBK Competency-Based Training
14|DEMO-14|Melakukan Asesmen Berbasis Kompetensi|Conduct Competency-Based Assessment`,
els:[E('nomor',1,'{nomor}',652,568,600,25,'left'),E('nama',1,'{NAMA}',207,808,1000,48,'center',{b:1}),E('reg',1,'{reg}',676,872,600,25,'left'),
E('bI',1,'{bI}',207,1095,1000,34,'center',{b:1}),E('bE',1,'{bE}',207,1136,1000,28,'center',{b:1,i:1,c:'#555555'}),
E('kI',1,'{kI}',207,1340,1000,34,'center',{b:1}),E('kE',1,'{kE}',207,1379,1000,28,'center',{b:1,i:1,c:'#555555'}),
E('mI',1,'{mI}',736,1464,400,25,'left'),E('mE',1,'{mE}',708,1508,400,22,'left',{i:1,c:'#555555'}),E('tgl',1,'{tgl}',699,1585,500,25,'left'),
E('pj',1,'{pj}',207,1830,1000,24,'center'),{id:'s1',pg:1,k:'sig',x:480,y:1663,w:452,r:0},
{id:'tb',pg:2,k:'tbl',x:235,y:313,w:1058,s:21,c:'#1d1d1d',f:'Arial',r:0},E('tgl2',2,'{tgl}',995,1521,300,25,'left'),
E('nm2',2,'{nama}',384,1668,500,26,'center',{b:1}),E('pj2',2,'{pj}',785,1668,500,26,'center',{b:1}),{id:'s2',pg:2,k:'sig',x:850,y:1546,w:412,r:0}]};
S.cols=[{h:'NO',w:77},{h:'KODE',w:153},{h:'JUDUL UNIT KOMPETENSI',w:0,en:1}];S.rows=S.tbl.split('\n').map(l=>{const c=l.split('|');return[c[0],c[1],c[2]+'\n'+c[3]]});delete S.tbl;
const pad=(n,l)=>String(n).padStart(l,'0'),rnd=(a,b)=>a+Math.floor(Math.random()*(b-a+1));
const pf=(p,k)=>S.same?S.com[k]:p[k];
function code(s){const w=s.toUpperCase().split(/\s+/).filter(x=>x&&x!='DAN'&&x!='&');return w.length==1?w[0].slice(0,3):w.map(x=>x[0]).join('').slice(0,4)}
function nums(r){const y=new Date().getFullYear(),g={};
S.people.forEach(p=>{if(r||!p.mid)p.mid=pad(rnd(1,99999),5);p.nomor=`${S.prefix} ${p.mid} ${y}`;const k=pf(p,'bI')+'|'+pf(p,'kI');(g[k]=g[k]||[]).push(p)});
for(const k in g)g[k].forEach((p,i)=>{p.reg=`${code(pf(p,'bI'))}-${code(pf(p,'kI'))}-${S.prefix}-${y}-${pad((+g[k][0].mid%9000)+i+1,4)}`})}
function parse(){const L=$('#raw').value.split('\n').map(x=>x.trim()).filter(Boolean),n=[];S.date=S.date;
L.forEach(l=>{const m=l.match(/^tanggal\s*[:\-]?\s*(.+)/i);m?S.date=m[1]:n.push(l)});
S.people=n.map(x=>({n:x,...S.com}));S.cur=0;nums(1);ui()}
function ui(){const K=[['bI','Bidang (ID)'],['bE','Bidang (EN)'],['kI','Kualifikasi (ID)'],['kE','Kualifikasi (EN)'],['mI','Masa berlaku (ID)'],['mE','Masa berlaku (EN)']];
const f=(o,i)=>K.map(([k,l])=>`<label class="hint">${l}<input value="${esc(o[k])}" data-k="${k}" data-i="${i}"></label>`).join('');
$('#com').innerHTML=S.same?`<div class="row">${f(S.com,'c')}</div><button class="g" onclick="trAll('c')">🌐 Terjemahkan ke Inggris</button><button class="g" style="color:var(--ac2)" onclick="clrEn('c')">⌫ Kosongkan Inggris</button>`:'';
$('#ppl').innerHTML=S.people.map((p,i)=>`<div class="p"><b>${i+1}.</b> <input value="${esc(p.n)}" data-k="n" data-i="${i}"><div class="row"><input value="${esc(p.nomor)}" data-k="nomor" data-i="${i}"><input value="${esc(p.reg)}" data-k="reg" data-i="${i}"></div>${S.same?'':'<div class="row">'+f(p,i)+'</div><button class="g" onclick="trAll('+i+')">🌐 Terjemahkan ke Inggris</button><button class="g" style="color:var(--ac2)" onclick="clrEn('+i+')">⌫ Kosongkan Inggris</button>'}</div>`).join('');
rows();$('#cp').innerHTML=S.people.map((p,i)=>`<option value="${i}">${esc(p.n)}</option>`).join('');$('#cp').value=S.cur;
document.querySelectorAll('#L [data-k]').forEach(e=>e.oninput=()=>{const{k,i}=e.dataset;if(i=='c'){S.com[k]=e.value}else{S.people[i][k]=e.value}
if(['bI','kI'].includes(k)){nums(0);if(i=='c'||1){document.querySelectorAll('#ppl [data-k=reg]').forEach((x,j)=>x.value=S.people[j].reg)}}
if(k=='n')$('#cp').options[i].text=e.value;if(S.auto&&MAP[k])sched(k+i,()=>trField(i,k));rr()});rr()}
function rows(){
$('#cols').innerHTML=S.cols.map((c,j)=>`<div class="rw"><span class="hint">K${j+1}</span><input data-c="h" data-j="${j}" value="${esc(c.h)}" placeholder="Judul header" style="flex:1 1 130px;width:auto"><input type=number data-c="w" data-j="${j}" value="${c.w}" title="Lebar px (0=otomatis)" style="width:64px"><label class="hint" style="flex:0 0 auto"><input type=checkbox data-c="en" data-j="${j}" ${c.en?'checked':''}> 2 baris</label><button class="g" style="color:var(--ac2)" onclick="delCol(${j})">✕</button></div>`).join('');
$('#rows').innerHTML=S.rows.map((r,i)=>`<div class="rw"><span class="hint">${i+1}</span>${S.cols.map((c,j)=>{const t=String(r[j]??'').split('\n');return c.en?`<input data-r="${i}" data-j="${j}" data-l="0" placeholder="${esc(c.h)} (ID)" value="${esc(t[0])}" style="flex:1 1 130px;width:auto"><input data-r="${i}" data-j="${j}" data-l="1" placeholder="${esc(c.h)} (EN)" value="${esc(t.slice(1).join(' '))}" style="flex:1 1 130px;width:auto"><button class="g" onclick="trCell(${i},${j})" title="Terjemahkan baris ini">🌐</button><button class="g" style="color:var(--ac2)" onclick="clrCell(${i},${j})" title="Hapus baris Inggris">⌫</button>`:`<input data-r="${i}" data-j="${j}" placeholder="${esc(c.h)}" value="${esc(t.join(' '))}" style="flex:1 1 70px;width:auto;min-width:60px">`}).join('')}<button class="g" style="color:var(--ac2)" onclick="delRow(${i})">✕</button></div>`).join('');
document.querySelectorAll('#cols input').forEach(i=>i.oninput=()=>{const c=S.cols[+i.dataset.j],k=i.dataset.c;if(k=='h')c.h=i.value;else if(k=='w')c.w=+i.value||0;else{c.en=i.checked?1:0;rows()}rr()});
document.querySelectorAll('#rows input').forEach(i=>i.oninput=()=>{const r=S.rows[+i.dataset.r],j=+i.dataset.j;if(i.dataset.l===undefined)r[j]=i.value;else{const t=String(r[j]??'').split('\n');if(i.dataset.l=='0')t[0]=i.value;else t[1]=i.value;r[j]=t[0]+'\n'+(t[1]||'');if(S.auto&&i.dataset.l=='0')sched('r'+i.dataset.r+'_'+j,()=>trCell(+i.dataset.r,j))}rr()})}
function addRow(){const n=S.rows.length+1;S.rows.push(S.cols.map((c,j)=>j==0?String(n):j==1?'DEMO-'+pad(n,2):''));rows();rr()}
function delRow(i){S.rows.splice(i,1);rows();rr()}
function addCol(){S.cols.push({h:'KOLOM BARU',w:120,en:0});S.rows.forEach(r=>r.push(''));rows();rr()}
function delCol(j){if(S.cols.length<2)return;S.cols.splice(j,1);S.rows.forEach(r=>r.splice(j,1));rows();rr()}
const MAP={bI:'bE',kI:'kE',mI:'mE'},TM={},TC={},SM=new Set(['and','of','the','in','for','to','a','an','on','at','by','or','with']);
const title=s=>s.toLowerCase().replace(/\b[\w']+/g,(w,i)=>(i&&SM.has(w))?w:w[0].toUpperCase()+w.slice(1));
const sched=(k,f)=>{clearTimeout(TM[k]);TM[k]=setTimeout(f,900)},tmsg=s=>{const e=$('#tm');if(e)e.textContent=s};
async function net(q){try{const r=await fetch('https://translate.googleapis.com/translate_a/single?client=gtx&sl=id&tl=en&dt=t&q='+encodeURIComponent(q));const j=await r.json(),s=j[0].map(x=>x[0]).join('');if(s)return s}catch(e){}
try{const r=await fetch('https://api.mymemory.translated.net/get?q='+encodeURIComponent(q)+'&langpair=id|en'),j=await r.json(),s=j.responseData.translatedText;if(s&&!/MYMEMORY WARNING/i.test(s))return s}catch(e){}return null}
async function tr(t,k){t=(t||'').trim();if(!t)return'';const q=t===t.toUpperCase()&&t.length>3?t.toLowerCase():t;tmsg('Menerjemahkan…');let r=TC[q]??(TC[q]=await net(q));if(r==null){delete TC[q];tmsg('Gagal menerjemahkan (cek internet) — isi Inggris manual.');return null}tmsg('');return k=='kI'?r.toUpperCase():k=='bI'?title(r):r}
async function trField(i,k){const o=i=='c'?S.com:S.people[i],src=o[k],t=await tr(src,k);if(t==null||o[k]!==src)return;o[MAP[k]]=t;const x=document.querySelector(`#L [data-k=${MAP[k]}][data-i="${i}"]`);if(x)x.value=t;rr()}
const cut1=v=>String(v??'').split('\n')[0];
function clrCell(i,j){S.rows[i][j]=cut1(S.rows[i][j]);rows();rr()}
function clrRows(){S.rows.forEach(r=>S.cols.forEach((c,j)=>{if(c.en)r[j]=cut1(r[j])}));rows();rr()}
function clrEn(i){const o=i=='c'?S.com:S.people[i];o.bE=o.kE=o.mE='';ui()}
async function trAll(i){for(const k in MAP)await trField(i,k)}
async function trCell(i,j){const r=S.rows[i];if(!r)return;const a=String(r[j]??'').split('\n'),src=a[0],t=await tr(src,'t');if(t==null||String(S.rows[i]?.[j]??'').split('\n')[0]!==src)return;r[j]=src+'\n'+t;const x=document.querySelector(`#rows input[data-r="${i}"][data-j="${j}"][data-l="1"]`);if(x)x.value=t;rr()}
async function trRows(){for(let i=0;i<S.rows.length;i++)for(let j=0;j<S.cols.length;j++)if(S.cols[j].en){tmsg(`Baris ${i+1}/${S.rows.length}…`);await trCell(i,j)}tmsg('Selesai.')}
function acak(){const d=new Date();S.prefix=pad(d.getDate(),2)+pad(d.getMonth()+1,2);$('#pfx').value=S.prefix;nums(1);ui()}
function sig(n,i){const f=i.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{S.sig[n]=r.result;rr()};r.readAsDataURL(f)}
function vals(p){const g=k=>pf(p,k);return{nama:p.n,NAMA:p.n.toUpperCase(),nomor:p.nomor,reg:p.reg,bI:g('bI'),bE:g('bE'),kI:g('kI'),kE:g('kE'),mI:g('mI'),mE:g('mE'),tgl:S.date,pj:S.pj}}
function build(pg,p,ed){const d=document.createElement('div');d.style.cssText='position:relative;width:1414px;height:2000px;overflow:hidden';if(ed)d.className='ed';
d.innerHTML=`<img src="${pg==1?T1:T2}" style="position:absolute;left:0;top:0;width:1414px;height:2000px">`;const v=p?vals(p):{};
S.els.filter(e=>e.pg==pg).forEach(e=>{const n=document.createElement('div');n.className='el'+(ed&&S.sel==e.id?' sel':'');n.dataset.id=e.id;
n.style.cssText+=`left:${e.x}px;top:${e.y}px;width:${e.w}px;transform:rotate(${e.r}deg);transform-origin:center`;
if(e.k=='sig'){const u=S.sig[e.id[1]];n.style.whiteSpace='normal';n.innerHTML=u?`<img src="${u}" style="width:100%;display:block">`:(ed?`<div style="height:${e.w*.22}px;border:3px dashed #04c;color:#04c;display:flex;align-items:center;justify-content:center;font:22px Arial">Area TTD ${e.id[1]}</div>`:'')}
else if(e.k=='tbl'){n.style.whiteSpace='normal';n.style.font=`${e.s}px ${e.f}`;n.style.color=e.c;const th='border:2px solid #8a8578;padding:';
n.innerHTML=`<table style="border-collapse:collapse;width:100%;table-layout:fixed;font:inherit"><colgroup>${S.cols.map(c=>`<col${c.w?` width=${c.w}`:''}>`).join('')}</colgroup><tr style="background:#ded8cc;font-weight:700;text-align:center">${S.cols.map(c=>`<td style="${th}14px 6px">${esc(c.h)}</td>`).join('')}</tr>`+S.rows.map(r=>`<tr>${S.cols.map((c,j)=>{const t=String(r[j]??'').split('\n');return c.en?`<td style="${th}9px 10px;line-height:1.25"><b>${esc(t[0])}</b>${t.length>1&&t[1]?'<br><i style="font-size:.95em">'+esc(t.slice(1).join(' '))+'</i>':''}</td>`:`<td style="${th}10px 4px;text-align:center">${esc(t.join(' '))}</td>`}).join('')}</tr>`).join('')+'</table>'}
else{n.style.cssText+=`;font:${e.i?'italic ':''}${e.b?'bold ':''}${e.s}px ${e.f};color:${e.c};text-align:${e.al}`;n.textContent=e.t.replace(/\{(\w+)\}/g,(m,k)=>v[k]??m)}
if(ed){n.onpointerdown=ev=>drag(ev,e,n);if(S.sel==e.id){const h=document.createElement('div');h.className='hd';h.onpointerdown=ev=>drag(ev,e,n,1);n.appendChild(h)}}d.appendChild(n)});
if(ed)S.gd.forEach(g=>{const n=document.createElement('div');n.className='gd '+g.o;n.style[g.o=='v'?'left':'top']=g.p+'px';n.onpointerdown=ev=>{ev.preventDefault();n.setPointerCapture(ev.pointerId);n.onpointermove=m=>{const r=$('#pg').getBoundingClientRect();g.p=Math.round(((g.o=='v'?m.clientX-r.left:m.clientY-r.top))/S.z);n.style[g.o=='v'?'left':'top']=g.p+'px'};n.onpointerup=()=>n.onpointermove=null};d.appendChild(n)});return d}
let last=null,U=[],Rd=[],lt=0,sh=0;
const shot=()=>JSON.stringify({els:S.els,gd:S.gd,cols:S.cols,rows:S.rows,pj:S.pj,com:S.com,people:S.people,date:S.date,same:S.same,prefix:S.prefix});
function commit(){const s=shot();if(last==null){last=s;return}if(s==last)return;if(Date.now()-lt>500){U.push(last);if(U.length>100)U.shift()}lt=Date.now();last=s;Rd=[]}
function load(s){const o=JSON.parse(s);Object.assign(S,o);$('#same').checked=!!S.same;$('#pj').value=S.pj;$('#pfx').value=S.prefix;S.cur=Math.max(0,Math.min(S.cur,S.people.length-1));last=s;ui()}
function undo(){if(!U.length)return;Rd.push(last);load(U.pop())}
function redo(){if(!Rd.length)return;U.push(last);load(Rd.pop())}
function pnm(){$('#vw').classList.toggle('pn',!!(sh||S.pan))}
addEventListener('keydown',e=>{if(e.key=='Shift'){sh=1;pnm()}if((e.ctrlKey||e.metaKey)&&!e.altKey&&e.target.id!='raw'){const k=e.key.toLowerCase();if(k=='z'){e.preventDefault();e.shiftKey?redo():undo()}else if(k=='y'){e.preventDefault();redo()}}});
addEventListener('keyup',e=>{if(e.key=='Shift'){sh=0;pnm()}});addEventListener('blur',()=>{sh=0;pnm()});
$('#vw').addEventListener('pointerdown',e=>{if(!(e.shiftKey||S.pan))return;e.preventDefault();e.stopPropagation();const v=$('#vw'),sx=e.clientX,sy=e.clientY,l=S.px,t=S.py;v.setPointerCapture(e.pointerId);v.onpointermove=m=>{S.px=l+m.clientX-sx;S.py=t+m.clientY-sy;Z()};v.onpointerup=()=>v.onpointermove=null},true);
function rr(){commit();const p=S.people[S.cur];const d=build(S.pg,p,S.edit);const pg=$('#pg');pg.innerHTML='';pg.appendChild(d);Z();props()}
function Z(){$('#pg').style.transform=`scale(${S.z})`;$('#pgw').style.transform=`translate(${S.px}px,${S.py}px)`;$('#pgw').style.width=1414*S.z+'px';$('#pgw').style.height=2000*S.z+'px';$('#st').dataset.z=1;st()}
function st(){const e=S.els.find(x=>x.id==S.sel);$('#st').innerHTML=`Zoom ${Math.round(S.z*100)}% · ${e?'Dipilih: '+e.id:'Klik elemen untuk memilih'} · Ctrl+scroll = zoom ke kursor · Tahan Shift + seret = geser preview (HP: tombol ✋ Geser) · Ctrl+Z / Ctrl+Y = undo/redo`}
function zm(f,cx,cy){const v=$('#vw'),r=v.getBoundingClientRect(),w=$('#pgw').getBoundingClientRect();cx=cx??r.left+r.width/2;cy=cy??r.top+r.height/2;
const px=(cx-w.left)/S.z,py=(cy-w.top)/S.z;S.z=Math.min(3,Math.max(.12,S.z*f));Z();const w2=$('#pgw').getBoundingClientRect();S.px+=cx-(w2.left+px*S.z);S.py+=cy-(w2.top+py*S.z);Z()}
function fit(){S.z=Math.max(.12,Math.min(1.5,($('#vw').clientWidth-24)/1414));S.px=S.py=0;Z()}
addEventListener('wheel',e=>{if(!(e.ctrlKey||e.metaKey))return;e.preventDefault();const f=e.deltaY<0?1.1:.9,r=$('#vw').getBoundingClientRect();(e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom)?zm(f,e.clientX,e.clientY):zm(f)},{passive:false});
addEventListener('keydown',e=>{if(!(e.ctrlKey||e.metaKey))return;if(e.key=='+'||e.key=='='){e.preventDefault();zm(1.25)}else if(e.key=='-'){e.preventDefault();zm(.8)}else if(e.key=='0'){e.preventDefault();fit()}});
addEventListener('gesturestart',e=>e.preventDefault());
function gd(o){S.gd.push({o,p:o=='v'?707:1000});S.edit=1;rr()}
function drag(ev,e,n,rs){ev.preventDefault();ev.stopPropagation();const sel=S.sel!=e.id;S.sel=e.id;if(sel){document.querySelectorAll('.el').forEach(x=>x.classList.toggle('sel',x.dataset.id==e.id));document.querySelectorAll('.hd').forEach(x=>x.remove());const h=document.createElement('div');h.className='hd';h.onpointerdown=v=>drag(v,e,n,1);n.appendChild(h);props();st()}
const sx=ev.clientX,sy=ev.clientY,o={x:e.x,y:e.y,w:e.w};n.setPointerCapture(ev.pointerId);
n.onpointermove=m=>{const dx=(m.clientX-sx)/S.z,dy=(m.clientY-sy)/S.z;
if(rs){e.w=Math.max(30,Math.round(o.w+dx))}else{e.x=o.x+dx;e.y=o.y+dy;if(S.snap)snap(e,n);e.x=Math.round(e.x);e.y=Math.round(e.y)}
n.style.left=e.x+'px';n.style.top=e.y+'px';n.style.width=e.w+'px'};
n.onpointerup=()=>{n.onpointermove=null;commit();props()}}
function snap(e,n){const h=n.offsetHeight,tx=[707,235,1293,...S.els.filter(o=>o.pg==e.pg&&o!=e).flatMap(o=>[o.x,o.x+o.w/2,o.x+o.w]),...S.gd.filter(g=>g.o=='v').map(g=>g.p)],ty=[1000,...S.gd.filter(g=>g.o=='h').map(g=>g.p)];
const go=(a,off,ts)=>{for(const t of ts)for(const q of off)if(Math.abs(a+q-t)<9)return t-q;return Math.round(a/5)*5};
e.x=go(e.x,[0,e.w/2,e.w],tx);e.y=go(e.y,[0,h/2,h],ty)}
function props(){const e=S.els.find(x=>x.id==S.sel),b=$('#b1');$('#b1').style.outline=S.pg==1?'2px solid var(--ac)':'';$('#b2').style.outline=S.pg==2?'2px solid var(--ac)':'';let P=$('#props');
if(!P){P=document.createElement('div');P.id='props';P.className='card';P.style.cssText='margin:0;border-radius:0;max-height:34vh;overflow:auto';$('#R').appendChild(P)}
if(!e){P.innerHTML='<span class="hint">Pilih elemen di preview untuk edit teks, font, ukuran, warna, posisi, rotasi.</span>';return}
const t=!e.k,F=['Arial','Helvetica','Times New Roman','Georgia','Verdana','Trebuchet MS','Courier New','Tahoma'];
P.innerHTML=`<div class="row"><b>${e.id}</b>${t?`<input data-p="t" value="${esc(e.t)}" style="flex:3 1 200px">`:''}${e.k=='sig'?'':`<select data-p="f">${F.map(f=>`<option ${f==e.f?'selected':''}>${f}</option>`).join('')}</select><label>Ukuran <input type=number data-p="s" value="${e.s}"></label><input type=color data-p="c" value="${e.c}">`}
${t?`<label><input type=checkbox data-p="b" ${e.b?'checked':''}>B</label><label><input type=checkbox data-p="i" ${e.i?'checked':''}>I</label><select data-p="al">${['left','center','right'].map(a=>`<option ${a==e.al?'selected':''}>${a}</option>`).join('')}</select>`:''}
<label>X <input type=number data-p="x" value="${Math.round(e.x)}"></label><label>Y <input type=number data-p="y" value="${Math.round(e.y)}"></label><label>Lebar <input type=number data-p="w" value="${Math.round(e.w)}"></label><label>Rotasi° <input type=number data-p="r" value="${e.r}"></label></div>
<div class="row" style="margin-top:6px">${t?'<span class="hint" style="flex:0 0 auto">Rata teks</span><button class="g" data-t="left">⇤ Kiri</button><button class="g" data-t="center">⇔ Tengah</button><button class="g" data-t="right">⇥ Kanan</button>':''}<span class="hint" style="flex:0 0 auto">Posisi di halaman</span><button class="g" data-a="L">◧ Kiri</button><button class="g" data-a="C">◫ Tengah</button><button class="g" data-a="R">◨ Kanan</button></div>`;
P.querySelectorAll('[data-t]').forEach(b=>b.onclick=()=>{e.al=b.dataset.t;rr()});
P.querySelectorAll('[data-a]').forEach(b=>b.onclick=()=>{const a=b.dataset.a;e.x=a=='L'?235:a=='C'?Math.round(707-e.w/2):1293-e.w;rr()});
P.querySelectorAll('[data-p]').forEach(i=>i.oninput=()=>{const k=i.dataset.p;e[k]=i.type=='checkbox'?+i.checked:(['t','f','c','al'].includes(k)||i.tagName=='SELECT'?i.value:+i.value);commit();const x=$('#pg');const d=build(S.pg,S.people[S.cur],S.edit);x.innerHTML='';x.appendChild(d)})}
async function mk(p){const{jsPDF}=window.jspdf,doc=new jsPDF({unit:'px',format:[1414,2000],orientation:'p',hotfixes:['px_scaling']});
for(const g of[1,2]){const n=build(g,p,false);$('#host').appendChild(n);const c=await html2canvas(n,{scale:1,backgroundColor:null,useCORS:true});n.remove();if(g==2)doc.addPage([1414,2000],'p');doc.addImage(c.toDataURL('image/jpeg',.92),'JPEG',0,0,1414,2000)}return doc}
const fn=s=>s.replace(/[\\/:*?"<>|]/g,'').trim()||'sertifikat';
async function dl(all){const m=$('#msg');try{if(!all){m.textContent='Membuat PDF…';(await mk(S.people[S.cur])).save(fn(S.people[S.cur].n)+'.pdf');m.textContent='Selesai.';return}
const z=new JSZip(),u={};for(let i=0;i<S.people.length;i++){m.textContent=`Membuat ${i+1}/${S.people.length}…`;const p=S.people[i];let n=fn(p.n);u[n]=(u[n]||0)+1;if(u[n]>1)n+=' ('+u[n]+')';z.file(n+'.pdf',(await mk(p)).output('blob'))}
const b=await z.generateAsync({type:'blob'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='sertifikat-j-expert.zip';a.click();m.textContent='ZIP selesai.'}catch(x){m.textContent='Gagal: '+x.message+' (pastikan internet aktif untuk memuat library)'}}
$('#vw').addEventListener('pointerdown',e=>{if(e.target.id=='vw'||e.target.id=='pgw'){S.sel=null;rr()}});
parse();setTimeout(fit,50);
</script></body></html>
